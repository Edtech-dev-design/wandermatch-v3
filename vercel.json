{
  "version": 2,
  "framework": null,
  "installCommand": "echo 'Skip install'",
  "buildCommand": "echo 'Static build'",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
