{
  "version": 2,
  "framework": null,
  "buildCommand": "echo 'Static frontend assets ready in frontend/'",
  "outputDirectory": "frontend",
  "git": {
    "deploymentEnabled": {
      "main": false,
      "feat/v4-architecture": true
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://wandermatch-api-staging.vannong20182018.workers.dev/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
